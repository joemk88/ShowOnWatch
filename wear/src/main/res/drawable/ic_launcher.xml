<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp" android:height="48dp"
    android:viewportWidth="48" android:viewportHeight="48">

    <!-- Same shapes and proportions as the phone icon; Wear OS adds the round background -->
    <!-- Strap top -->
    <path android:pathData="M17.6,1.5H30.4Q31.6,1.5 31.8,2.7L33.6,13H14.4L16.2,2.7Q16.4,1.5 17.6,1.5Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="24" android:startY="1.5" android:endX="24" android:endY="13">
                <item android:offset="0" android:color="#FF5F6368" />
                <item android:offset="1" android:color="#FF3C4043" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Strap bottom -->
    <path android:pathData="M17.6,46.5H30.4Q31.6,46.5 31.8,45.3L33.6,35H14.4L16.2,45.3Q16.4,46.5 17.6,46.5Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="24" android:startY="35" android:endX="24" android:endY="46.5">
                <item android:offset="0" android:color="#FF3C4043" />
                <item android:offset="1" android:color="#FF202124" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Bezel -->
    <path android:pathData="M24,8.5a15.5,15.5 0,1 1,0 31a15.5,15.5 0,1 1,0 -31Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="12" android:startY="10" android:endX="36" android:endY="38">
                <item android:offset="0" android:color="#FF5F6368" />
                <item android:offset="1" android:color="#FF202124" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Picture on the face, clipped to the face circle -->
    <group>
        <clip-path android:pathData="M24,11.5a12.5,12.5 0,1 1,0 25a12.5,12.5 0,1 1,0 -25Z" />
        <!-- Sky -->
        <path android:pathData="M8,8H40V40H8Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="24" android:startY="11.5" android:endX="24" android:endY="32">
                    <item android:offset="0" android:color="#FFAECBFA" />
                    <item android:offset="1" android:color="#FF4285F4" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Sun -->
        <path android:pathData="M29.5,16.2a2.5,2.5 0,1 1,0 5a2.5,2.5 0,1 1,0 -5Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="28" android:startY="16.2" android:endX="31" android:endY="21.2">
                    <item android:offset="0" android:color="#FFFDE293" />
                    <item android:offset="1" android:color="#FFFBBC04" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Back mountain (right peak) -->
        <path android:pathData="M29.5,25L39,33.5V40H17V36Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="29.5" android:startY="25" android:endX="29.5" android:endY="37">
                    <item android:offset="0" android:color="#FF34A853" />
                    <item android:offset="1" android:color="#FF137333" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Front mountain (left peak) -->
        <path android:pathData="M19.5,21.5L33.5,39H5V35.4Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="19.5" android:startY="21.5" android:endX="19.5" android:endY="37">
                    <item android:offset="0" android:color="#FF81C995" />
                    <item android:offset="1" android:color="#FF34A853" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Sunlit face of the front peak -->
        <path android:pathData="M19.5,21.5L22.7,25.5L17.8,37H5V35.4Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="12" android:startY="22" android:endX="20" android:endY="37">
                    <item android:offset="0" android:color="#FFA8DAB5" />
                    <item android:offset="1" android:color="#FF5BB974" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Glass highlight -->
    <path android:pathData="M24,11.5a12.5,12.5 0,0 0,-12.5 12.5a13,11 0,0 1,25 -3.5a12.5,12.5 0,0 0,-12.5 -9Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="24" android:startY="11.5" android:endX="24" android:endY="24">
                <item android:offset="0" android:color="#40FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
